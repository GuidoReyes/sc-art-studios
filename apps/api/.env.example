# Copiar a apps/api/.env (gitignored). NUNCA subir valores reales.

# --- MySQL local (docker-compose.yml, npm run db:up) ---
# Generar contraseñas con: openssl rand -hex 24
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_ROOT_PASSWORD=
# Local: mysql://sc_app:<LOCAL_MYSQL_PASSWORD>@127.0.0.1:3306/sc_art_studio
# Producción (Railway Variables del servicio API): ${{MySQL.MYSQL_URL}} — red privada, nunca en .env local
DATABASE_URL=

# Opcionales: PORT (8080 por defecto; Railway lo inyecta) y LOG_LEVEL (info)
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=https://scartstudios.com
SHOPIFY_WEBHOOK_SECRET=

# --- Formulario de encargos (opcionales en desarrollo, obligatorias en producción) ---
# Turnstile: en local se pueden usar las llaves de prueba públicas de Cloudflare
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
TURNSTILE_SECRET=
# Bucket PRIVADO de R2 para las fotos de referencia (sin dominio público ni r2.dev).
# Token de API de R2 con permiso de lectura/escritura solo sobre ese bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
